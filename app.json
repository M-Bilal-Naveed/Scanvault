{
  "expo": {
    "name": "ScanVault",
    "slug": "scanvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mbilalnaveed.scanvault",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ScanVault uses the camera to scan pages. Photos stay on your device.",
        "NSPhotoLibraryUsageDescription": "ScanVault reads photos you choose to turn into PDFs."
      }
    },
    "android": {
      "package": "com.mbilalnaveed.scanvault",
      "adaptiveIcon": {
        "backgroundColor": "#0E1630",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": ["CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1630",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScanVault uses the camera to scan pages.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScanVault reads photos you choose to turn into PDFs.",
          "cameraPermission": "ScanVault uses the camera to take photos."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sharing"
    ]
  }
}
